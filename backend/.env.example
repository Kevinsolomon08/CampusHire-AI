# .env.example
# Copy this to .env and fill in your values before starting the server.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=mysql+pymysql://campushire_user:yourpassword@localhost:3306/campushire

# ---------------------------------------------------------------------------
# JWT Authentication
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=your-secret-key-change-in-production-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# File Uploads
# ---------------------------------------------------------------------------
UPLOAD_DIRECTORY=uploads

# ---------------------------------------------------------------------------
# AI — Semantic Embedding Model
# Configures the SentenceTransformer model for resume-job similarity scoring.
# "all-MiniLM-L6-v2" is a small, CPU-friendly 384-dim model; a good default.
# For higher accuracy on longer documents, consider "all-mpnet-base-v2" (768-dim).
# ---------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
